# Main NeonAi bot — staff slash commands (/stripe, /deliver, /setup, …)
DISCORD_BOT_TOKEN=your_staff_bot_token_here

# Always-on ticket bot — create "NeonAi Tickets" app in Discord Developer Portal
DISCORD_TICKET_BOT_TOKEN=

# Right-click your server → Copy Server ID (enable Developer Mode in Discord settings)
DISCORD_GUILD_ID=your_server_id_here

# Your Discord user ID — gets Admin role during setup
DISCORD_OWNER_ID=your_user_id_here

# Public landing page URL (hardware FAQ links in compatibility tickets)
NEONAI_WEBSITE_URL=https://neonai-official.netlify.app
