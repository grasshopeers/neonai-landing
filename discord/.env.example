# Main NeonAi bot — staff slash commands (/stripe, /deliver, /setup, …)
DISCORD_BOT_TOKEN=your_staff_bot_token_here

# Always-on ticket bot — create "NeonAi Tickets" app in Discord Developer Portal
DISCORD_TICKET_BOT_TOKEN=

# Right-click your server → Copy Server ID (enable Developer Mode in Discord settings)
DISCORD_GUILD_ID=your_server_id_here

# Your Discord user ID — gets Admin role during setup
DISCORD_OWNER_ID=your_user_id_here

# Public landing page URL (hardware FAQ links in compatibility tickets)
NEONAI_WEBSITE_URL=https://neonai-official.netlify.app

# Ko-fi tip page for /kofi (one link; bot tells customer the tier amount)
# KOFI_TIP_URL=https://ko-fi.com/drowndeer

# PayPal checkout or paypal.me link posted in purchase tickets
# PAYPAL_PAYMENT_URL=https://www.paypal.com/paypalme/Aasimzaz

# License redeem — Cloudflare verify-status (auto-accept)
# NEONAI_VERIFY_STATUS_URL=https://neonai-license.shioneggs.workers.dev/verify-status

# Optional local plaintext inventory (never commit / never put on Render)
# LICENSE_INVENTORY_PATH=C:\Users\aadit\Downloads\NeonAi\deploy\LICENSE_KEYS_FULL_INVENTORY.txt

# Optional hashed inventory index (safe to deploy — built via npm run build-license-index)
# LICENSE_INVENTORY_INDEX_PATH=

# Optional — for cloud 24/7 on Render (https://dashboard.render.com/u/settings#api-keys)
# RENDER_API_KEY=
